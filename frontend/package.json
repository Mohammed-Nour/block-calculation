{
  "name": "blockcalc-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/check-conventions.mjs && pnpm format && pnpm lint && pnpm typecheck && pnpm test",
    "prepush:fullcheck": "pnpm check && pnpm build && pnpm check:security",
    "check:security": "pnpm audit --audit-level=moderate",
    "lint-staged": "lint-staged",
    "prepare": "cd .. && husky frontend/.husky"
  },
  "dependencies": {
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-slot": "1.2.4",
    "@tailwindcss/vite": "4.2.1",
    "@tanstack/react-devtools": "0.10.5",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-router": "1.170.42",
    "@tanstack/react-router-devtools": "1.167.2",
    "axios": "1.21.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.545.0",
    "radix-ui": "1.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.5.0",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.3",
    "@tanstack/devtools-vite": "0.7.0",
    "@tanstack/eslint-config": "0.4.0",
    "@tanstack/eslint-plugin-router": "1.162.0",
    "@tanstack/router-plugin": "1.168.43",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.19.13",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.1.4",
    "eslint": "9.39.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-boundaries": "5.4.0",
    "eslint-plugin-react-hooks": "7.0.1",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "lint-staged": "16.3.1",
    "micromatch": "4.0.8",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.61.0",
    "vite": "7.3.7",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "4.1.12"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "overrides": {
      "handlebars": ">=4.7.10 <5",
      "srvx": "0.11.13",
      "brace-expansion@<4": "1.1.16",
      "brace-expansion@>=4": "5.0.12",
      "minimatch": ">=9.0.5 <11",
      "shell-quote": ">=1.12.0 <2",
      "linkify-it": ">=5.0.2 <7",
      "markdown-it": "^14.3.3",
      "fast-uri": ">=4.2.3 <5",
      "yaml": "2.8.3",
      "uuid": "11.1.1",
      "form-data": ">=4.0.6 <5",
      "undici": "7.30.1",
      "seroval": ">=1.6.2 <2",
      "launch-editor": ">=2.14.2 <3",
      "source-map-js": ">=1.2.2 <2",
      "follow-redirects": ">=1.16.2 <2",
      "js-yaml": ">=5.4.1 <6",
      "nanoid@>=3 <3.3.18": "3.3.18",
      "esbuild": "0.28.1",
      "@babel/core": "7.29.6",
      "axios": ">=1.20.0 <2",
      "postcss": ">=8.5.18 <9",
      "browserslist": ">=4.28.7 <5",
      "baseline-browser-mapping": ">=2.11.0 <3",
      "@humanfs/node": ">=0.16.8 <0.18",
      "fflate": ">=0.6.11 <0.9"
    }
  }
}
